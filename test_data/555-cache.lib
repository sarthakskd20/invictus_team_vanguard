EESchema-LIBRARY Version 2.4
#encoding utf-8
#
# 555-rescue_TLC555-Timer
#
DEF 555-rescue_TLC555-Timer U 0 40 Y Y 1 F N
F0 "U" -100 425 50 H V R CNN
F1 "555-rescue_TLC555-Timer" -100 350 50 H V R CNN
F2 "" 50 -250 50 H I L CNN
F3 "" 650 -550 50 H I C CNN
F4 "X" -100 425 50 H V R CNN "Spice_Primitive"
F5 "TLC555" -100 425 50 H V R CNN "Spice_Model"
F6 "Y" -100 425 50 H V R CNN "Spice_Netlist_Enabled"
F7 "TLC555ng.LIB" -100 425 50 H V R CNN "Spice_Lib_File"
$FPLIST
 DIP*W7.62mm*
 SOIC*3.9x4.9mm*P1.27mm*
$ENDFPLIST
DRAW
S -400 300 400 -200 0 1 10 f
X GND 1 0 -300 100 U 50 50 1 1 W
X ~TRIG 2 -500 0 100 R 50 50 1 1 I
X OUT 3 500 0 100 L 50 50 1 1 O
X ~RESET 4 500 200 100 L 50 50 1 1 I
X CONT 5 500 -100 100 L 50 50 1 1 P
X THRES 6 -500 -100 100 R 50 50 1 1 I
X DISCH 7 -500 200 100 R 50 50 1 1 C
X VDD 8 0 400 100 D 50 50 1 1 W
ENDDRAW
ENDDEF
